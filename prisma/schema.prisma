// Prisma Schema for PT EMKL FAJAR
// Database: PostgreSQL (Prisma 7+ compatible)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique
  password      String?
  role          String    @default("Operator") // Admin | Operator
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  shipments     Shipment[]
  notifications Notification[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Shipment {
  id                String   @id @default(cuid())
  // Header Info
  namaKapal         String?
  etd               String?
  merk              String?
  
  // Legacy fields (kept optional for backward compatibility or direct single-item use if needed)
  namaBarang        String?
  jumlah            Int?
  satuan            String?
  ukuran            String?  // e.g. "20ft", "40ft"
  hargaSatuan       Float?   // Unit price

  tujuan            String   // Merauke | Sorong
  penerima          String
  // pelayaran         String   // Spill | Tanto - DEPRECATED or keep if still used? 
  // Let's keep pelayaran as it might be useful, but maybe namaKapal replaces generic pelayaran?
  // The screenshot shows "Nama Kapal (Vessel)" input.
  // The existing schema had "pelayaran" which was "Spill" or "Tanto".
  // I'll keep "pelayaran" for now as it's required in the old form, but make it optional if we want to rely on the new form 
  // OR the user might want to select the shipping line AND the vessel name.
  // However, looking at the UI, "Nama Kapal" is a text input. I'll make 'pelayaran' optional to avoid validation errors if the new form doesn't send it.
  pelayaran         String?   

  nomorKontainer    String
  
  tanggalPengiriman DateTime
  status            String   @default("Active") // Active | Completed | Pending
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  
  items             ShipmentItem[]
}

model ShipmentItem {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  
  jumlah      Int
  satuan      String
  namaBarang  String
  ukuran      String?
  kubik       Float?
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?  // Optional: Global notification if null, specific if set
  user      User?    @relation(fields: [userId], references: [id])
}
